# ─────────────────────────────────────────────
# AI Lead Intelligence Engine — Backend ENV
# Copy this to .env — NEVER commit .env to GitHub
# This system requires ZERO API keys
# ─────────────────────────────────────────────

NODE_ENV=development
PORT=5000
ALLOWED_ORIGINS=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cache (seconds)
CACHE_TTL_SECONDS=300

# Overpass API (public, free, no key needed)
OVERPASS_TIMEOUT_MS=10000